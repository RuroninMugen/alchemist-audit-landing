# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# NocoDB — used server-side only (app/api/lead/route.ts), never exposed to the client.
NOCODB_API_URL=http://localhost:8080
NOCODB_API_TOKEN=
# Internal table id for "leads", generated by scripts/setup-nocodb.mjs
NOCODB_TABLE_ID=

# Resend — used server-side only.
RESEND_API_KEY=
# Where internal lead notifications are sent.
RESEND_NOTIFY_EMAIL=you@example.com
# Sender address. onboarding@resend.dev is Resend's shared test domain:
# it can only deliver to the email address of the Resend account owner.
RESEND_FROM_EMAIL=onboarding@resend.dev
